{
  "name": "tiktok-creator-analytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "data:build": "node scripts/build-dashboard-data.mjs",
    "data:content": "node scripts/build-content-data.mjs",
    "data:audience": "node scripts/build-audience-data.mjs",
    "data:assistant": "node scripts/build-assistant-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "build:analyze": "cross-env ANALYZE=true next build --webpack"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@faker-js/faker": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "echarts": "^5.6.0",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-window": "1.8.11",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
